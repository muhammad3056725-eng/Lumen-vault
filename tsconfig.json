{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@lumen-vault/shared-types": ["./packages/shared-types/src/index.ts"],
      "@lumen-vault/vault-engine": ["./packages/vault-engine/src/index.ts"]
    }
  },
  "include": [
    "apps/web/src",
    "apps/web/test",
    "apps/web/vite.config.ts",
    "packages/shared-types/src",
    "packages/vault-engine/src",
    "packages/vault-engine/test",
    "tools/**/*.ts"
  ]
}